; FlutterFileManager - C++ 模块 FFI 符号导出表（Windows）
; 静态库直接集成进 exe 后，Dart 通过 DynamicLibrary.process() 查找这些符号。
; media 库的符号已由 media.h 的 MEDIA_API (__declspec(dllexport)) 自动导出，
; 无需在此列出。

EXPORTS
; ---- system ----
system_info
system_dir_display_name
system_standard_dir
system_runtime_info
system_free_string

; ---- file ----
file_access
file_chmod
file_chown
file_compare_files
file_compute_hash
file_copy_file
file_create_directory
file_create_file
file_decrypt_file
file_delete_file
file_detect_encoding
file_encrypt_file
file_exists
file_find_duplicates
file_find_empty_files
file_free_json
file_get_disk_usage
file_get_file_info
file_get_home_dir
file_get_recent_files
file_get_root_dir
file_is_directory
file_lchown
file_link
file_list_directory
file_merge_files
file_move_file
file_read_csv_file
file_read_hex_chunk
file_readlink
file_read_text_file
file_realpath
file_rename
file_search_files
file_split_file
file_symlink
file_text_stats
file_write_text_file

; ---- text ----
text_close
text_create
text_destroy
text_error
text_is_open
text_line_count
text_open
text_path
text_read
text_read_line
text_size
